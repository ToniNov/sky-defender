{
  "name": "sky-defender",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:single": "tsc -b && vite build --mode single",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "api:dev": "wrangler dev -c worker/wrangler.toml",
    "api:deploy": "wrangler deploy -c worker/wrangler.toml",
    "api:migrate": "wrangler d1 migrations apply sky-defender --remote -c worker/wrangler.toml",
    "api:migrate:local": "wrangler d1 migrations apply sky-defender --local -c worker/wrangler.toml"
  },
  "dependencies": {
    "@pixi/react": "^8.0.5",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
